# ZOCO environment variables — TEMPLATE ONLY (safe to commit; no real values).
#
# HOW TO USE:
#   1. Local dev:  copy this to `.env.local` and fill in real values.
#                  `.env.local` is gitignored — it never gets committed.
#   2. Production: add the SAME variables in the Vercel dashboard
#                  (Project → Settings → Environment Variables).
#
# The app code only ever reads these by NAME (process.env.X / import.meta.env.X),
# so the developer never needs to see or handle your secret values.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECRECY GUIDE
#   [PUBLIC]  shipped to the browser by design — not sensitive.
#   [SECRET]  server-only. NEVER commit, NEVER put in client code, NEVER paste
#             into chat/email. Only ever lives in .env.local + Vercel env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (consumer auth) ────────────────────────────────────────────────
# Note: the server verifies ID tokens against Google's PUBLIC keys, so there is
# NO Firebase server secret / service-account key to manage. Server needs only
# the project id (which is public anyway — it's inside every token).

# [PUBLIC] server-side: which Firebase project tokens must belong to.
FIREBASE_PROJECT_ID=

# [PUBLIC] client-side (Vite exposes VITE_* to the browser). These are the
# Firebase web-app config — designed to be embedded in client code. Security
# comes from Firebase sign-in settings + the authorized-domains allowlist, not
# from hiding these. Get them from: Firebase console → Project settings →
# "Your apps" → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Razorpay (subscriptions) ────────────────────────────────────────────────
# Use TEST keys (rzp_test_...) during development — real checkout flow, fake
# cards, no real money. Swap to live keys only at launch.

# [PUBLIC] client-side: the publishable key id, used to open Razorpay checkout.
VITE_RAZORPAY_KEY_ID=

# [SECRET] server-only: used to create subscriptions via Razorpay's API.
RAZORPAY_KEY_SECRET=

# [SECRET] server-only: verifies the HMAC signature on incoming webhooks so
# nobody can forge a "payment succeeded" call. Set when you create the webhook
# in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# [PUBLIC] Razorpay Subscription Plan ids — one per tier, created in the
# dashboard (in the SAME mode as your keys: test plans for rzp_test_ keys).
# Launch tiers: Monthly ₹99, Quarterly ₹249, Yearly ₹799.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_QUARTERLY=
RAZORPAY_PLAN_ID_YEARLY=
# [PUBLIC] Legacy single-plan id — optional fallback used only when a tier
# above is unset (kept so older single-plan configs still work in dev).
RAZORPAY_PLAN_ID=

# ── Native app builds (Capacitor) ───────────────────────────────────────────
# [PUBLIC] Backend URL baked into the NATIVE app bundle. Leave UNSET for web
# builds (same-origin '/api' as always). For the Android/iOS app build:
#   VITE_API_BASE=https://your-app.vercel.app npm run build && npx cap sync
VITE_API_BASE=

# [PUBLIC] Extra origins allowed to call the gated APIs (comma-separated).
# The Capacitor app origins (https://localhost, capacitor://localhost) are
# always allowed; add e.g. a staging web origin here if needed.
ALLOWED_APP_ORIGINS=

# ── Already in use (existing app) ───────────────────────────────────────────
# [SECRET] Vercel KV / Upstash — stores the scan meter + subscription state.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# [SECRET] admin console token(s) — see docs/ADMIN_GUIDE.md
ADMIN_TOKEN=
